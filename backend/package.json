{
  "name": "nettic-backend",
  "version": "1.0.0",
  "description": "Backend NETTIC - Control de Asistencia",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --require tsconfig-paths/register --respawn --transpile-only --ignore-watch node_modules src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "typeorm": "typeorm",
    "migration:generate": "typeorm migration:generate",
    "migration:run": "typeorm migration:run",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "asistencia",
    "horas-extras",
    "control-empleados"
  ],
  "author": "NETTIC Dev Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
